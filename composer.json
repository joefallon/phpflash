{
    "name": "joefallon/phpflash",
    "type": "library",
    "description": "A simple library for flash messages.",
    "keywords": [
        "PHP",
        "flash messages"
    ],
    "homepage": "https://github.com/joefallon/phpflash",
    "license": "MIT",
    "authors": [
        {
            "name": "Joe Fallon",
            "email": "joseph.t.fallon@gmail.com",
            "homepage": "https://www.joefallon.net/"
        }
    ],
    "require": {
        "php": ">=7.4.0",
        "ext-json": "*",
        "joefallon/phpsession": "^5.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "JoeFallon\\": "src/JoeFallon/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    }
}
